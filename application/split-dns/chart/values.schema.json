{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "replicaCount", "image", "service", "serviceAccount", "containerPort", "healthPort", "dnsPolicy", "dns", "metrics", "pdb", "podSpread", "updateStrategy", "resources"],
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"imageRegistry": {"type": "string"}}
    },
    "common": {"type": "object"},
    "commonLabels": {"type": "object", "additionalProperties": {"type": "string"}},
    "commonAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
    "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
    "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
    "replicaCount": {"type": "integer", "minimum": 1},
    "revisionHistoryLimit": {"type": "integer", "minimum": 0},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "registry": {"type": "string"},
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-fA-F0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {"create": {"type": "boolean"}, "name": {"type": "string"}}
    },
    "containerPort": {"type": "integer", "minimum": 1, "maximum": 65535},
    "healthPort": {"type": "integer", "minimum": 1, "maximum": 65535},
    "dnsPolicy": {"type": "string", "const": "ClusterFirst"},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "clusterIP", "port", "annotations"],
      "properties": {
        "type": {"type": "string", "const": "ClusterIP"},
        "clusterIP": {"oneOf": [{"type": "string", "const": ""}, {"type": "string", "format": "ipv4"}, {"type": "string", "format": "ipv6"}]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultUpstreamGroup", "upstreamGroups", "proxies", "rules", "cache"],
      "properties": {
        "defaultUpstreamGroup": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
        "upstreamGroups": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,31}$": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "queryTimeout", "maxConcurrentRequests"],
              "properties": {
                "type": {"type": "string", "enum": ["forward", "doh"]},
                "servers": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}:[0-9]{1,5}$|^\\[[0-9A-Fa-f:]+\\]:[0-9]{1,5}$"}},
                "strategy": {"type": "string", "enum": ["parallel"]},
                "endpoints": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["url"],
                    "properties": {
                      "url": {"type": "string", "format": "uri", "pattern": "^https://[^/@#]+(/[^#]*)?$"},
                      "bootstrapIPs": {"type": "array", "items": {"oneOf": [{"type": "string", "format": "ipv4"}, {"type": "string", "format": "ipv6"}] }},
                      "ca": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "secretName": {"type": "string", "minLength": 1},
                          "configMapName": {"type": "string", "minLength": 1},
                          "key": {"type": "string", "minLength": 1}
                        },
                        "oneOf": [{"required": ["secretName"], "not": {"required": ["configMapName"]}}, {"required": ["configMapName"], "not": {"required": ["secretName"]}}]
                      }
                    }
                  }
                },
                "egress": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["mode"],
                  "properties": {"mode": {"type": "string", "enum": ["direct", "proxy"]}, "proxyRef": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}},
                  "allOf": [{"if": {"properties": {"mode": {"const": "proxy"}}}, "then": {"required": ["proxyRef"]}}, {"if": {"properties": {"mode": {"const": "direct"}}}, "then": {"properties": {"proxyRef": {"const": ""}}}}]
                },
                "queryTimeout": {"type": "string", "pattern": "^[1-9][0-9]*(ns|ms|s|m|h)$"},
                "connectTimeout": {"type": "string", "pattern": "^[1-9][0-9]*(ns|ms|s|m|h)$"},
                "tlsHandshakeTimeout": {"type": "string", "pattern": "^[1-9][0-9]*(ns|ms|s|m|h)$"},
                "maxAttemptsPerEndpoint": {"type": "integer", "minimum": 1},
                "maxConcurrentRequests": {"type": "integer", "minimum": 1}
              },
              "allOf": [
                {"if": {"properties": {"type": {"const": "forward"}}}, "then": {"required": ["servers"], "properties": {"endpoints": {"maxItems": 0}}, "not": {"anyOf": [{"required": ["strategy"]}, {"required": ["egress"]}, {"required": ["connectTimeout"]}, {"required": ["tlsHandshakeTimeout"]}, {"required": ["maxAttemptsPerEndpoint"]}]}}},
                {"if": {"properties": {"type": {"const": "doh"}}}, "then": {"required": ["strategy", "endpoints", "egress", "connectTimeout", "tlsHandshakeTimeout", "maxAttemptsPerEndpoint"], "properties": {"servers": {"maxItems": 0}, "strategy": {"const": "parallel"}}}}
              ]
            }
          },
          "additionalProperties": false
        },
        "proxies": {
          "type": "object",
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,31}$": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url"],
              "properties": {
                "url": {"type": "string", "pattern": "^http://[^/@?#]+$"},
                "auth": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["existingSecret", "usernameKey", "passwordKey"],
                  "properties": {"existingSecret": {"type": "string", "minLength": 1}, "usernameKey": {"type": "string", "minLength": 1}, "passwordKey": {"type": "string", "minLength": 1}}
                }
              }
            }
          },
          "additionalProperties": false
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["match", "domain", "upstreamGroup"],
            "properties": {
              "match": {"type": "string", "enum": ["exact", "suffix"]},
              "domain": {"type": "string", "pattern": "^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.?$"},
              "upstreamGroup": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}
            }
          }
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "maxEntries", "maxTTL", "negativeMaxTTL"],
          "properties": {"enabled": {"type": "boolean"}, "maxEntries": {"type": "integer", "minimum": 1, "maximum": 16384}, "maxTTL": {"type": "integer", "minimum": 1}, "negativeMaxTTL": {"type": "integer", "minimum": 1}}
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "port"],
      "properties": {"enabled": {"type": "boolean"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minAvailable"],
      "properties": {"enabled": {"type": "boolean"}, "minAvailable": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string", "pattern": "^(100|[1-9]?[0-9])%$"}]}}
    },
    "podSpread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "maxSkew", "topologyKey", "whenUnsatisfiable"],
      "properties": {"enabled": {"type": "boolean"}, "maxSkew": {"type": "integer", "minimum": 1}, "topologyKey": {"type": "string", "minLength": 1}, "whenUnsatisfiable": {"type": "string", "enum": ["DoNotSchedule", "ScheduleAnyway"]}}
    },
    "updateStrategy": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "containerSecurityContext": {"type": "object"},
    "resources": {"type": "object"},
    "startupProbe": {"type": "object"},
    "livenessProbe": {"type": "object"},
    "readinessProbe": {"type": "object"},
    "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"}
  }
}
