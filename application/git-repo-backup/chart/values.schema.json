{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "git-repo-backup values",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "ssh", "storage", "schedule"],
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "schedule": {"type": "string", "minLength": 1},
    "timeZone": {"type": "string", "minLength": 1},
    "suspend": {"type": "boolean"},
    "concurrencyPolicy": {"enum": ["Forbid", "Allow", "Replace"]},
    "startingDeadlineSeconds": {"type": "integer", "minimum": 1},
    "activeDeadlineSeconds": {"type": "integer", "minimum": 1},
    "backoffLimit": {"type": "integer", "minimum": 0},
    "successfulJobsHistoryLimit": {"type": "integer", "minimum": 0},
    "failedJobsHistoryLimit": {"type": "integer", "minimum": 0},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "registry": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "tag": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
        },
        "digest": {"type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array"},
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "url": {"type": "string", "minLength": 1}
        }
      }
    },
    "repositoriesConfigMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingConfigMap": {"type": "string"},
        "key": {"type": "string", "minLength": 1}
      }
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret"],
      "properties": {
        "existingSecret": {"type": "string", "minLength": 1},
        "privateKeyKey": {"type": "string", "minLength": 1},
        "knownHosts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key"],
          "properties": {
            "existingConfigMap": {"type": "string"},
            "existingSecret": {"type": "string"},
            "key": {"type": "string", "minLength": 1}
          },
          "oneOf": [
            {
              "properties": {"existingConfigMap": {"minLength": 1}},
              "required": ["existingConfigMap"],
              "not": {"properties": {"existingSecret": {"minLength": 1}}}
            },
            {
              "properties": {"existingSecret": {"minLength": 1}},
              "required": ["existingSecret"],
              "not": {"properties": {"existingConfigMap": {"minLength": 1}}}
            }
          ]
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "local", "s3"],
      "properties": {
        "type": {"enum": ["local", "s3"]},
        "local": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mountPath", "existingClaim", "persistence"],
          "properties": {
            "mountPath": {"type": "string", "pattern": "^/.*", "not": {"enum": ["/"]}},
            "existingClaim": {"type": "string"},
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": {"type": "boolean"},
                "storageClass": {"type": "string"},
                "accessModes": {"type": "array", "minItems": 1},
                "size": {"type": "string", "minLength": 1},
                "annotations": {"type": "object"}
              }
            }
          }
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {"type": "string"},
            "region": {"type": "string"},
            "bucket": {"type": "string"},
            "prefix": {"type": "string"},
            "forcePathStyle": {"type": "boolean"},
            "credentialsMode": {"enum": ["secret", "workloadIdentity"]},
            "existingSecret": {"type": "string"},
            "accessKeyIdKey": {"type": "string"},
            "secretAccessKeyKey": {"type": "string"},
            "sessionTokenKey": {"type": "string"},
            "roleArn": {"type": "string"},
            "serverSideEncryption": {"enum": ["", "AES256", "aws:kms"]},
            "kmsKeyId": {"type": "string"}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "local"}}},
          "then": {
            "oneOf": [
              {
                "properties": {
                  "local": {
                    "properties": {
                      "existingClaim": {"minLength": 1},
                      "persistence": {"properties": {"enabled": {"const": false}}}
                    }
                  }
                }
              },
              {
                "properties": {
                  "local": {
                    "properties": {
                      "existingClaim": {"maxLength": 0},
                      "persistence": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]}
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {"properties": {"type": {"const": "s3"}}},
          "then": {
            "required": ["s3"],
            "allOf": [
              {
                "properties": {
                  "s3": {
                    "required": ["bucket", "region", "prefix", "credentialsMode"],
                    "properties": {
                      "bucket": {"minLength": 1, "not": {"pattern": "^s3://|/"}},
                      "region": {"minLength": 1},
                      "prefix": {
                        "minLength": 1,
                        "not": {
                          "anyOf": [
                            {"pattern": "^/"},
                            {"pattern": "/$"},
                            {"pattern": "//"},
                            {"pattern": "\\\\"},
                            {"pattern": "(^|/)\\.{1,2}(/|$)"},
                            {"pattern": "\\s"}
                          ]
                        }
                      },
                      "accessKeyIdKey": {"minLength": 1},
                      "secretAccessKeyKey": {"minLength": 1}
                    }
                  }
                }
              },
              {
                "if": {"properties": {"s3": {"properties": {"credentialsMode": {"const": "secret"}}}}},
                "then": {
                  "properties": {"s3": {"required": ["existingSecret"], "properties": {"existingSecret": {"minLength": 1}}}}
                }
              },
              {
                "if": {"properties": {"s3": {"properties": {"credentialsMode": {"const": "workloadIdentity"}}}}},
                "then": {
                  "properties": {
                    "s3": {
                      "properties": {
                        "existingSecret": {"maxLength": 0},
                        "roleArn": {"minLength": 1}
                      },
                      "required": ["roleArn"]
                    }
                  }
                }
              },
              {
                "if": {"properties": {"s3": {"properties": {"serverSideEncryption": {"const": "aws:kms"}}}}},
                "then": {"properties": {"s3": {"properties": {"kmsKeyId": {"minLength": 1}}, "required": ["kmsKeyId"]}}},
                "else": {"properties": {"s3": {"properties": {"kmsKeyId": {"maxLength": 0}}}}}
              }
            ]
          }
        }
      ]
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": {"type": "string"},
        "emptyDir": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"sizeLimit": {"type": "string", "minLength": 1}}
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"}
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compressionLevel": {"type": "integer", "minimum": 1, "maximum": 9},
        "maxRunDuration": {"type": "string", "minLength": 1, "not": {"pattern": "^[0-9]+d$"}},
        "gitTimeout": {"type": "string", "minLength": 1, "not": {"pattern": "^[0-9]+d$"}},
        "minFreeBytes": {"type": ["integer", "string"], "minimum": 1, "minLength": 1}
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "maxBackups": {"type": "integer", "minimum": 0},
        "maxAge": {"type": "string"},
        "incompleteMaxAge": {"type": "string", "minLength": 1, "not": {"pattern": "^[0-9]+d$"}}
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"level": {"enum": ["debug", "info", "warn", "error"]}}
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"type": "object"}
      }
    },
    "automountServiceAccountToken": {"not": {"enum": [true]}},
    "customCA": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "existingConfigMap": {"type": "string"},
        "existingSecret": {"type": "string"},
        "key": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {"properties": {"existingConfigMap": {"maxLength": 0}, "existingSecret": {"maxLength": 0}}},
        {"properties": {"existingConfigMap": {"minLength": 1}}, "required": ["existingConfigMap"], "not": {"properties": {"existingSecret": {"minLength": 1}}}},
        {"properties": {"existingSecret": {"minLength": 1}}, "required": ["existingSecret"], "not": {"properties": {"existingConfigMap": {"minLength": 1}}}}
      ]
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": true,
      "required": ["runAsNonRoot", "runAsUser", "runAsGroup"],
      "properties": {
        "runAsNonRoot": {"const": true},
        "runAsUser": {"type": "integer", "minimum": 1},
        "runAsGroup": {"type": "integer", "minimum": 1},
        "seccompProfile": {
          "type": "object",
          "additionalProperties": true,
          "properties": {"type": {"enum": ["RuntimeDefault", "Localhost"]}}
        }
      }
    },
    "containerSecurityContext": {
      "type": "object",
      "additionalProperties": true,
      "required": ["readOnlyRootFilesystem", "allowPrivilegeEscalation", "capabilities"],
      "properties": {
        "readOnlyRootFilesystem": {"const": true},
        "allowPrivilegeEscalation": {"const": false},
        "capabilities": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "drop": {"type": "array"},
            "add": {"type": "array", "maxItems": 0}
          }
        }
      }
    },
    "resources": {"type": "object", "additionalProperties": true},
    "initResources": {"type": "object", "additionalProperties": true},
    "nodeSelector": {"type": "object"},
    "affinity": {"type": "object"},
    "tolerations": {"type": "array"},
    "topologySpreadConstraints": {"type": "array"},
    "commonLabels": {"type": "object"},
    "commonAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "podAnnotations": {"type": "object"},
    "cronJobAnnotations": {"type": "object"},
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "egress": {"type": "array"}
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {"repositories": {"minItems": 1}},
          "required": ["repositories"],
          "not": {"properties": {"repositoriesConfigMap": {"properties": {"existingConfigMap": {"minLength": 1}}}}}
        },
        {
          "properties": {
            "repositories": {"maxItems": 0},
            "repositoriesConfigMap": {
              "properties": {"existingConfigMap": {"minLength": 1}},
              "required": ["existingConfigMap"]
            }
          },
          "required": ["repositoriesConfigMap"]
        }
      ]
    },
    {
      "if": {
        "properties": {
          "cache": {"properties": {"enabled": {"const": true}}},
          "storage": {"properties": {"type": {"const": "s3"}}}
        }
      },
      "then": {
        "properties": {"cache": {"properties": {"existingClaim": {"minLength": 1}}, "required": ["existingClaim"]}}
      }
    }
  ]
}
