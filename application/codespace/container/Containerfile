ARG UBUNTU_IMAGE=docker.io/library/ubuntu:24.04
FROM ${UBUNTU_IMAGE}

LABEL maintainer="k8s-at-home"

# Preinstalled tools live under /opt and /usr/local so a PVC mounted at the
# coder home does not hide image-layer binaries. User state stays in home.
ENV PATH=/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright

ARG DEBIAN_FRONTEND=noninteractive
ARG GO_VERSION=1.27.2
ARG GO_DOWNLOAD_BASE=https://go.dev/dl
ARG NODEJS_VERSION=v24.22.0
ARG HELM_VERSION=v4.3.1
ARG HELM_DOWNLOAD_BASE=https://get.helm.sh
ARG KUBECTL_VERSION=v1.37.1
ARG KUBECTL_DOWNLOAD_BASE=https://dl.k8s.io/release
ARG ORAS_VERSION=1.3.5
ARG ORAS_DOWNLOAD_BASE=https://github.com/oras-project/oras/releases/download
ARG MAGPIE_RELEASE_API=https://api.github.com/repos/yetone/magpie/releases/latest
ARG MAGPIE_RELEASE_BASE=https://github.com/yetone/magpie/releases/download
ARG PLAYWRIGHT_VERSION=1.64.1

# Install the development workstation and rootful Podman runtime packages.
RUN sed -i -E '/^Components:/ { /(^|[[:space:]])universe([[:space:]]|$)/! s/$/ universe/; }' \
        /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        debianutils \
        dnsutils \
        gcc \
        git \
        gh \
        fuse-overlayfs \
        img2pdf \
        iproute2 \
        iptables \
        iputils-ping \
        jq \
        language-pack-zh-hans \
        less \
        libc6-dev \
        locales \
        ncurses-bin \
        openssh-server \
        openssl \
        pdftk \
        podman \
        poppler-utils \
        procps \
        python3 \
        ripgrep \
        screen \
        slirp4netns \
        skopeo \
        sudo \
        telnet \
        tini \
        tmux \
        tree \
        uidmap \
        unzip \
        vim \
        wget \
        xz-utils \
        yq \
    && rm -rf /var/lib/apt/lists/* \
    && skopeo --version \
    && locale-gen en_US.UTF-8 zh_CN.UTF-8 \
    && update-locale LANG=en_US.UTF-8 \
    && rm -f /etc/ssh/ssh_host_*_key /etc/ssh/ssh_host_*_key.pub \
    && install -d -m 0755 /run/sshd \
    && install -d -m 0700 /root/.ssh \
    && install -d -m 0755 /etc/ssh/authorized_keys.d \
    && printf '%s\n' \
        'PermitRootLogin prohibit-password' \
        'PasswordAuthentication no' \
        'KbdInteractiveAuthentication no' \
        'AuthorizedKeysFile .ssh/authorized_keys /etc/ssh/authorized_keys.d/%u' \
        > /etc/ssh/sshd_config.d/codespace.conf

ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    LANGUAGE=en_US:en

# Non-root account for unattended coding agents. Ubuntu 24.04 ships an
# "ubuntu" user at UID 1000 -- replace it with coder so home PVC ownership
# stays predictable.
RUN userdel -r ubuntu \
    && groupadd --gid 1000 coder \
    && useradd --uid 1000 --gid coder --shell /bin/bash --create-home coder \
    && printf 'coder ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/coder \
    && chmod 0440 /etc/sudoers.d/coder

RUN case "$(uname -m)" in \
        x86_64) GO_ARCH=amd64 ;; \
        aarch64) GO_ARCH=arm64 ;; \
        *) echo "Unsupported architecture for Go: $(uname -m)" >&2; exit 1 ;; \
    esac \
    && curl -4 -fsSL --retry 3 --retry-all-errors --retry-delay 2 \
        --connect-timeout 30 --max-time 600 \
        "${GO_DOWNLOAD_BASE}/go${GO_VERSION}.linux-${GO_ARCH}.tar.gz" \
        -o /tmp/go.tar.gz \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm -f /tmp/go.tar.gz

RUN case "$(uname -m)" in \
        x86_64) NODE_ARCH=x64 ;; \
        aarch64) NODE_ARCH=arm64 ;; \
        *) echo "Unsupported architecture for Node.js: $(uname -m)" >&2; exit 1 ;; \
    esac \
    && curl -4 -fsSL --retry 3 --connect-timeout 10 --max-time 300 \
        "https://nodejs.org/dist/${NODEJS_VERSION}/node-${NODEJS_VERSION}-linux-${NODE_ARCH}.tar.xz" \
        -o /tmp/nodejs.tar.xz \
    && tar -xJf /tmp/nodejs.tar.xz -C /usr/local --strip-components=1 \
    && rm -f /tmp/nodejs.tar.xz

# Install the latest AI coding CLIs globally under /usr/local so the coder
# home PVC does not hide the commands or their native packages.
RUN npm install --global "@anthropic-ai/claude-code" \
    && rm -rf /root/.npm

RUN npm install --global "@openai/codex" \
    && rm -rf /root/.npm

RUN npm install --global "@xai-official/grok" \
    && ln -sfn /usr/local/bin/grok /usr/local/bin/grok-agent \
    && rm -f /usr/local/bin/agent \
    && command -v claude \
    && command -v codex \
    && command -v grok \
    && command -v grok-agent \
    && test ! -e /usr/local/bin/agent \
    && claude --version \
    && codex --version \
    && grok --version

RUN case "$(uname -m)" in \
        x86_64) TOOL_ARCH=amd64 ;; \
        aarch64) TOOL_ARCH=arm64 ;; \
        *) echo "Unsupported architecture for Kubernetes tools: $(uname -m)" >&2; exit 1 ;; \
    esac \
    && curl -4 -fsSL --retry 3 --connect-timeout 10 --max-time 300 \
        "${HELM_DOWNLOAD_BASE}/helm-${HELM_VERSION}-linux-${TOOL_ARCH}.tar.gz" \
        -o /tmp/helm.tar.gz \
    && tar -xzf /tmp/helm.tar.gz -C /tmp \
    && install -m 0755 "/tmp/linux-${TOOL_ARCH}/helm" /usr/local/bin/helm \
    && curl -4 -fsSL --retry 3 --connect-timeout 10 --max-time 300 \
        "${KUBECTL_DOWNLOAD_BASE}/${KUBECTL_VERSION}/bin/linux/${TOOL_ARCH}/kubectl" \
        -o /usr/local/bin/kubectl \
    && chmod 0755 /usr/local/bin/kubectl \
    && rm -rf /tmp/helm.tar.gz "/tmp/linux-${TOOL_ARCH}"

# Install ORAS from its upstream release archive and verify the published checksum.
RUN case "$(uname -m)" in \
        x86_64) ORAS_ARCH=amd64 ;; \
        aarch64) ORAS_ARCH=arm64 ;; \
        *) echo "Unsupported architecture for ORAS: $(uname -m)" >&2; exit 1 ;; \
    esac \
    && ORAS_ARCHIVE="oras_${ORAS_VERSION}_linux_${ORAS_ARCH}.tar.gz" \
    && curl -4 -fsSL --retry 3 --retry-all-errors --retry-delay 2 \
        --connect-timeout 30 --max-time 300 \
        "${ORAS_DOWNLOAD_BASE}/v${ORAS_VERSION}/${ORAS_ARCHIVE}" \
        -o "/tmp/${ORAS_ARCHIVE}" \
    && curl -4 -fsSL --retry 3 --retry-all-errors --retry-delay 2 \
        --connect-timeout 30 --max-time 300 \
        "${ORAS_DOWNLOAD_BASE}/v${ORAS_VERSION}/oras_${ORAS_VERSION}_checksums.txt" \
        -o /tmp/oras_checksums.txt \
    && ORAS_CHECKSUM="$(awk -v archive="${ORAS_ARCHIVE}" '$2 == archive { print $1 }' /tmp/oras_checksums.txt)" \
    && test -n "${ORAS_CHECKSUM}" \
    && printf '%s  %s\n' "${ORAS_CHECKSUM}" "/tmp/${ORAS_ARCHIVE}" | sha256sum --check --status \
    && install -d -m 0755 /tmp/oras \
    && tar -xzf "/tmp/${ORAS_ARCHIVE}" -C /tmp/oras oras \
    && install -m 0755 /tmp/oras/oras /usr/local/bin/oras \
    && oras version \
    && rm -rf "/tmp/${ORAS_ARCHIVE}" /tmp/oras_checksums.txt /tmp/oras

# Cursor publishes its official CLI through cursor.com rather than an npm
# package. This npm wrapper downloads that official binary; remove its generic
# `agent` bin link so Cursor is exposed only as `cursor-agent`.
RUN npm install --global \
        "@nothumanwork/cursor-agent-cli" \
    && rm -f /usr/local/bin/agent \
    && command -v cursor-agent \
    && test ! -e /usr/local/bin/agent \
    && cursor-agent --version

# Magpie's CLI build works without a desktop environment or webview libraries.
RUN case "$(uname -m)" in \
        x86_64) MAGPIE_ARCH=amd64 ;; \
        aarch64) MAGPIE_ARCH=arm64 ;; \
        *) echo "Unsupported architecture for Magpie: $(uname -m)" >&2; exit 1 ;; \
    esac \
    && MAGPIE_RELEASE="$(curl -4 -fsSL --retry 3 --retry-all-errors --retry-delay 2 \
        --connect-timeout 30 --max-time 300 \
        -H 'Accept: application/vnd.github+json' "${MAGPIE_RELEASE_API}")" \
    && MAGPIE_VERSION="$(printf '%s' "${MAGPIE_RELEASE}" | jq -er '.tag_name')" \
    && MAGPIE_ASSET="magpie-cli-linux-${MAGPIE_ARCH}" \
    && MAGPIE_SHA256="$(printf '%s' "${MAGPIE_RELEASE}" | jq -er \
        --arg asset "${MAGPIE_ASSET}" \
        '.assets[] | select(.name == $asset) | .digest | select(startswith("sha256:")) | ltrimstr("sha256:")')" \
    && curl -4 -fsSL --retry 3 --retry-all-errors --retry-delay 2 \
        --connect-timeout 30 --max-time 300 \
        "${MAGPIE_RELEASE_BASE}/${MAGPIE_VERSION}/${MAGPIE_ASSET}" \
        -o /tmp/magpie \
    && printf '%s  %s\n' "${MAGPIE_SHA256}" /tmp/magpie | sha256sum --check --status \
    && install -m 0755 /tmp/magpie /usr/local/bin/magpie \
    && rm -f /tmp/magpie \
    && magpie --version

RUN npm install --global "playwright@${PLAYWRIGHT_VERSION}" \
    && rm -rf /root/.npm

RUN playwright install-deps chromium \
    && rm -rf /var/lib/apt/lists/*

RUN playwright install chromium

RUN if [ "$(uname -m)" = "x86_64" ]; then \
        playwright install-deps chrome \
        && rm -rf /var/lib/apt/lists/*; \
    fi

RUN if [ "$(uname -m)" = "x86_64" ]; then playwright install chrome; fi

# sshd supplies its own PATH for sessions instead of inheriting the image ENV.
RUN printf '%s\n' \
        'SetEnv PATH=/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin PLAYWRIGHT_BROWSERS_PATH=/opt/playwright LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 LANGUAGE=en_US:en' \
        >> /etc/ssh/sshd_config.d/codespace.conf

# The outer container is the cgroup boundary. A nested runtime cannot reliably
# delegate the Podman VM's cgroup v2 controllers, even when running privileged.
RUN install -d -m 0755 /etc/containers/containers.conf.d \
    && printf '%s\n' \
        '[containers]' \
        'cgroups = "disabled"' \
        'netns = "private"' \
        > /etc/containers/containers.conf.d/codespace.conf

COPY --chmod=0644 application/codespace/container/87-podman-bridge.conflist /etc/cni/net.d/87-podman-bridge.conflist
COPY --chmod=0755 application/codespace/container/entrypoint.sh /usr/local/bin/codespace-entrypoint

EXPOSE 22

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/codespace-entrypoint"]
